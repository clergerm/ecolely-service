{
  "family": "ecolely-service",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "ecolely-service-container",
      "image": "REPLACED_BY_GITHUB_ACTIONS",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ],
  "executionRoleArn": "arn:aws:iam::839922332389:role/ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::839922332389:role/ecs-exec-task-role",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024",
  "volumes": []
}